<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Text-/Info-Widget: GPS-Koordinaten + Geschwindigkeit über der Vorschau.
         Ab Android 12 müssen FINE und COARSE zusammen deklariert werden; der
         Provider nutzt FINE (GPS liefert auch Geschwindigkeit). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Web-Remote-Control über LAN: ab Android 17 (API 37) Pflicht für Apps
         mit targetSdk 37, damit die App auf das lokale Netzwerk zugreifen darf. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Foreground-Service: Stream läuft im Hintergrund weiter -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".irlbroadcaster.VividApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vivid"> <!-- Make sure this theme name matches your app's theme -->
        <service
            android:name=".irlbroadcaster.StreamingService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Benachrichtigungszugriff (vom Nutzer in den Systemeinstellungen gewährt)
             → erlaubt dem Chat-Bot, Media-Sessions fremder Apps zu steuern
             (!song / !next / !pause / !play / !prev). Der Listener liest keine
             Benachrichtigungen aus, er ist nur der Zugriffs-Marker. -->
        <service
            android:name="com.vivid.feature.chat.media.MediaNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- FileProvider: Teilen von Replay-MP4s (ReplayLibraryViewModel.shareIntent)
             ohne Speicher-Permissions. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".irlbroadcaster.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vivid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vivid" android:host="oauth" android:path="/twitch" />
            </intent-filter>
        </activity>
    
    <!-- Required: set your sentry.io project identifier (DSN) -->
    <meta-data android:name="io.sentry.dsn" android:value="https://d21707cb0ed76bc4ef0a58105548773f@o494918.ingest.us.sentry.io/4509837327990784" />
    <!-- Auto-Init deaktiviert: VividApplication initialisiert Sentry manuell mit
         sendDefaultPii=false und beforeSend (Opt-out-Toggle aus den Settings). -->
    <meta-data android:name="io.sentry.auto-init" android:value="false" />

    <!-- enable automatic breadcrumbs for user interactions (clicks, swipes, scrolls) -->
    <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="true" />
    <!-- Keine Crash-Screenshots: der Bildschirm kann Stream-Vorschau, Chat oder
         sichtbare Zugangsdaten enthalten (sensitive/PII) — siehe PRIVACY.md. -->
    <meta-data android:name="io.sentry.attach-screenshot" android:value="false" />
    <!-- enable view hierarchy for crashes -->
    <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="true" />

    <!-- enable the performance API by setting a sample-rate, adjust in production env -->
    <meta-data android:name="io.sentry.traces.sample-rate" android:value="1.0" />


</application>

</manifest>