    <!-- ===== Chat Bot & AI (SettingsChatBotScreen.kt) ===== -->
    <string name="chatbot_section_title">Chat bot (AI)</string>
    <string name="chatbot_section_desc">Automatic bot in the Twitch chat: either deterministic chat commands (like Moblin\'s bot) or an AI that decides on its own. All fields can be configured here — details: docs/ai-chat-bot.md.</string>
    <string name="chatbot_enabled">Enable chat bot</string>
    <string name="chatbot_mode_title">Mode</string>
    <string name="chatbot_mode_command">Bot (like Moblin)</string>
    <string name="chatbot_mode_autonomous">AI autonomous</string>
    <string name="chatbot_mode_command_desc">Bot like Moblin: only reacts to commands like !help, !uptime, !tts and !bot — no LLM needed, works without an AI key.</string>
    <string name="chatbot_mode_autonomous_desc">The AI decides on its own: the LLM evaluates every (allowed) message and decides whether and how to answer — including deliberately staying silent.</string>
    <string name="chatbot_account_title">Bot account &amp; LLM</string>
    <string name="chatbot_login_label">Bot login (Twitch, without @)</string>
    <string name="chatbot_oauth_label">Twitch OAuth token (user:read:chat + user:write:chat)</string>
    <string name="chatbot_api_base_url_label">LLM API base URL (OpenAI-compatible)</string>
    <string name="chatbot_api_key_label">LLM API key</string>
    <string name="chatbot_model_label">LLM model</string>
    <string name="chatbot_system_prompt_label">System prompt (optional)</string>
    <string name="chatbot_behavior_title">Bot behavior</string>
    <string name="chatbot_cooldown_label">Reply cooldown (seconds, 0 = off)</string>
    <string name="chatbot_mentions_only">Only reply to mentions</string>
    <string name="chatbot_max_per_minute_label">Max replies per minute (0 = unlimited)</string>
    <string name="chatbot_limits_desc">Limits (0 = off/unlimited) — cooldown and cap apply per viewer (work on all platforms: Twitch, Kick, YouTube …); moderators bypass the per-viewer limits. The hourly budget caps LLM costs globally.</string>
    <string name="chatbot_preset_title">Preset (quick start)</string>
    <string name="chatbot_preset_custom">Custom</string>
    <string name="chatbot_per_viewer_cooldown_label">Per-viewer cooldown (seconds, 0 = off)</string>
    <string name="chatbot_per_viewer_max_label">Max replies per viewer (per stream, 0 = unlimited)</string>
    <string name="chatbot_budget_label">Cost budget: max replies per hour (0 = unlimited)</string>
    <string name="chatbot_usage_title">Live usage</string>
    <string name="chatbot_usage_per_hour">Replies this hour: %1$s</string>
    <string name="chatbot_usage_no_budget">(no budget)</string>
    <string name="chatbot_usage_per_stream">Replies this stream: %1$d</string>
    <string name="chatbot_usage_top_viewers">Top viewers: %1$s</string>
    <string name="chatbot_usage_hint">Only shown while the bot is active — counters reset at stream end.</string>
    <string name="chatbot_coexistence_title">Coexistence with other bots</string>
    <string name="chatbot_coexistence_desc">Running alongside another tool\'s bot (e.g. Rivulet) in the same channel, collisions can be avoided: ignore other bots and narrow the command scope so both don\'t answer the same !-commands.</string>
    <string name="chatbot_ignore_bots_label">Ignore other bots (logins, comma-separated)</string>
    <string name="chatbot_scope_title">Command scope</string>
    <string name="chatbot_scope_all">All !-commands</string>
    <string name="chatbot_scope_mention">Only mentions</string>
    <string name="chatbot_scope_prefix">Own prefix</string>
    <string name="chatbot_scope_all_desc">Every !-command is answered (default, like Moblin\'s bot).</string>
    <string name="chatbot_scope_mention_desc">Only commands that address the bot directly (e.g. @vividbot !help) — generic commands stay with the other bot.</string>
    <string name="chatbot_scope_prefix_desc">Only commands with your own prefix (e.g. !v!help) — generic commands stay with the other bot.</string>
    <string name="chatbot_prefix_label">Own command prefix (e.g. v → !v!help)</string>
    <string name="chatbot_owner_title">Owner access (streamer only)</string>
    <string name="chatbot_owner_desc">Only you (and listed logins) can use the owner commands !start, !stop, !diag and !ask during an active stream — viewers only see a hint. The channel owner is automatically an owner (broadcaster badge); add extra logins here, e.g. your second account.</string>
    <string name="chatbot_owner_logins_label">Owner logins (comma-separated, without @)</string>
    <string name="chatbot_owner_llm_desc">Owner AI (optional, exclusive to streamer commands): !ask and the diagnosis recommendations of !diag run through this endpoint. Without a dedicated owner AI the commands fall back to the normal bot AI (only if that is also missing, !diag returns the checklist directly and !ask a hint).</string>
    <string name="chatbot_owner_llm_url_label">Owner LLM API base URL (OpenAI-compatible)</string>
    <string name="chatbot_owner_llm_key_label">Owner LLM API key</string>
    <string name="chatbot_owner_llm_model_label">Owner LLM model</string>
    <string name="chatbot_owner_source_label">AI source for owner commands: %1$s</string>
    <string name="owner_source_owner">dedicated owner AI (exclusive)</string>
    <string name="owner_source_owner_desc">!ask/!diag run through the configured owner LLM endpoint — viewer messages never reach it.</string>
    <string name="owner_source_viewer_fallback">viewer AI (fallback)</string>
    <string name="owner_source_viewer_fallback_desc">No dedicated owner AI configured — the commands use the normal bot AI with the owner context.</string>
    <string name="owner_source_deterministic">deterministic (without AI)</string>
    <string name="owner_source_deterministic_desc">Neither owner nor viewer AI configured — !diag returns the checklist directly, !ask a hint.</string>
    <string name="chatbot_owner_whisper">Reply privately (Whisper)</string>
    <string name="chatbot_owner_whisper_desc">Owner replies (!start/!stop/!diag/!ask) arrive via Twitch Whisper instead of the public chat. This requires the bot token to have the user:manage:whispers scope and the Twitch app client ID below; if the whisper fails (e.g. the recipient blocks strangers), the bot replies publicly.</string>
    <string name="chatbot_client_id_label">Twitch app client ID (for Whisper)</string>
    <string name="chatbot_media_desc">Media commands (!song / !next / !pause / !play / !prev) control the active music player — for that Vivid needs notification access (it does not read notifications).</string>
    <string name="chatbot_notification_access_button">Enable notification access</string>

    <!-- Profanity filter (!ask) -->
    <string name="chatbot_profanity_title">Profanity filter (!ask)</string>
    <string name="chatbot_profanity_desc">Blocks profanity, slurs and hostile language in !ask messages before the AI is called. Based on Twitch AutoMod, Kick and YouTube categories.</string>
    <string name="chatbot_profanity_enabled">Filter enabled</string>
    <string name="chatbot_profanity_categories">Active categories</string>
    <string name="chatbot_profanity_cat_slurs">Slurs / hateful language</string>
    <string name="chatbot_profanity_cat_sexual">Sexually explicit</string>
    <string name="chatbot_profanity_cat_hostility">Aggression / threats</string>
    <string name="chatbot_profanity_cat_profanity">General profanity</string>
    <string name="chatbot_profanity_custom_words">Custom blocked words</string>
    <string name="chatbot_profanity_custom_words_hint">e.g. banword1, banword2</string>
    <string name="chatbot_profanity_custom_words_desc">Additional words (comma-separated) that the filter should detect — on top of the base list.</string>
    <string name="chatbot_profanity_excluded_words">Excluded words</string>
    <string name="chatbot_profanity_excluded_words_hint">e.g. butt, mass, classes</string>
    <string name="chatbot_profanity_excluded_words_desc">Words (comma-separated) that the filter should ignore — for false positives (e.g. English words like "ass", "damn").</string>

