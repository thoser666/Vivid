{"repo": {"timestamp": 1788431739000, "version": 20002, "name": "Vivid Archive", "icon": "icon.png", "description": "Older versions of Vivid, kept available for downgrades and fallback.", "address": "https://thoser666.github.io/Vivid/fdroid/archive"}, "requests": {"install": [], "uninstall": []}, "apps": [{"categories": ["Internet", "Entertainment", "Multimedia"], "changelog": "https://github.com/thoser666/Vivid/releases", "suggestedVersionCode": "5062", "description": "<p>Vivid is an open-source IRL streaming application for Android.</p>\n<p><b>Features:</b></p>\n<ul>\n  <li>Live streaming via RTMP/SRT to Twitch, YouTube, Kick, and custom platforms</li>\n  <li>Real-time chat overlay with badges and emotes</li>\n  <li>AI-powered chat bot with configurable responses</li>\n  <li>Owner remote control commands</li>\n  <li>Dark mode with AMOLED support</li>\n  <li>Multi-language support (English, German, French)</li>\n  <li>Scene management and auto-switching</li>\n  <li>Real-time GPS overlay (altitude, speed, coordinates)</li>\n  <li>Custom RTMP/SRT endpoints</li>\n</ul>\n<p><a href=\"https://github.com/thoser666/Vivid\">Source Code</a> | <a href=\"https://github.com/thoser666/Vivid/issues\">Bug Reports</a></p>", "donate": "https://github.com/sponsors/thoser666", "issueTracker": "https://github.com/thoser666/Vivid/issues", "license": "MIT", "sourceCode": "https://github.com/thoser666/Vivid", "summary": "Open source IRL streaming app with chat bot and AI features", "webSite": "https://thoser666.github.io/Vivid/", "added": 1788431732000, "packageName": "com.vivid", "lastUpdated": 1788431739000, "localized": {"en-US": {"name": "Vivid"}}}], "packages": {"com.vivid": [{"added": 1788431737000, "apkName": "v0.5.6-beta_app-release.apk", "features": ["android.hardware.camera.any"], "hash": "2d558c85d2f2548adc8bc51de9efcd31db9ab233d667df3fc05f5a003391a54a", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "com.