    <!-- ===== Chat-Bot & KI (SettingsChatBotScreen.kt) ===== -->
    <string name="chatbot_section_title">Chat-Bot (KI)</string>
    <string name="chatbot_section_desc">Automatischer Bot im Twitch-Chat: entweder deterministische Chat-Befehle (wie der Bot von Moblin) oder eine KI, die selbst entscheidet. Alle Felder lassen sich hier konfigurieren — Details: docs/ai-chat-bot.md.</string>
    <string name="chatbot_enabled">Chat-Bot aktivieren</string>
    <string name="chatbot_mode_title">Betriebsmodus</string>
    <string name="chatbot_mode_command">Bot (wie Moblin)</string>
    <string name="chatbot_mode_autonomous">KI autonom</string>
    <string name="chatbot_mode_command_desc">Bot wie Moblin: reagiert nur auf Befehle wie !help, !uptime, !tts und !bot — kein LLM nötig, funktioniert ohne KI-Schlüssel.</string>
    <string name="chatbot_mode_autonomous_desc">KI entscheidet selbst: Das LLM bewertet jede (freigegebene) Nachricht und entscheidet, ob und wie es antwortet — inklusive bewusstem Schweigen.</string>
    <string name="chatbot_account_title">Bot-Konto &amp; LLM</string>
    <string name="chatbot_login_label">Bot-Login (Twitch, ohne @)</string>
    <string name="chatbot_oauth_label">Twitch-OAuth-Token (user:read:chat + user:write:chat)</string>
    <string name="chatbot_api_base_url_label">LLM API-Basis-URL (OpenAI-kompatibel)</string>
    <string name="chatbot_api_key_label">LLM API-Key</string>
    <string name="chatbot_model_label">LLM-Modell</string>
    <string name="chatbot_system_prompt_label">System-Prompt (optional)</string>
    <string name="chatbot_behavior_title">Bot-Verhalten</string>
    <string name="chatbot_cooldown_label">Antwort-Cooldown (Sekunden, 0 = aus)</string>
    <string name="chatbot_mentions_only">Nur auf Erwähnungen antworten</string>
    <string name="chatbot_max_per_minute_label">Max. Antworten pro Minute (0 = unbegrenzt)</string>
    <string name="chatbot_limits_desc">Begrenzungen (0 = aus/unbegrenzt) — Cooldown und Cap gelten pro Viewer (funktionieren auf allen Plattformen: Twitch, Kick, YouTube …); Moderatoren umgehen die Per-Viewer-Limits. Das Stunden-Budget deckelt die LLM-Kosten global.</string>
    <string name="chatbot_preset_title">Voreinstellung (Schnellstart)</string>
    <string name="chatbot_preset_custom">Eigene</string>
    <string name="chatbot_per_viewer_cooldown_label">Per-Viewer-Cooldown (Sekunden, 0 = aus)</string>
    <string name="chatbot_per_viewer_max_label">Max. Antworten pro Viewer (pro Stream, 0 = unbegrenzt)</string>
    <string name="chatbot_budget_label">Kosten-Budget: Max. Antworten pro Stunde (0 = unbegrenzt)</string>
    <string name="chatbot_usage_title">Live-Verbrauch</string>
    <string name="chatbot_usage_per_hour">Antworten diese Stunde: %1$s</string>
    <string name="chatbot_usage_no_budget">(kein Budget)</string>
    <string name="chatbot_usage_per_stream">Antworten in diesem Stream: %1$d</string>
    <string name="chatbot_usage_top_viewers">Top-Viewer: %1$s</string>
    <string name="chatbot_usage_hint">Wird nur angezeigt, solange der Bot aktiv ist — Zähler setzen bei Stream-Ende zurück.</string>
    <string name="chatbot_coexistence_title">Koexistenz mit anderen Bots</string>
    <string name="chatbot_coexistence_desc">Läuft neben dem Bot eines anderen Tools (z. B. Rivulet) im selben Kanal, lassen sich Kollisionen vermeiden: Andere Bots ignorieren und den Befehlsscope eingrenzen, damit nicht beide auf dieselben !-Befehle antworten.</string>
    <string name="chatbot_ignore_bots_label">Andere Bots ignorieren (Logins, kommasepariert)</string>
    <string name="chatbot_scope_title">Befehlsscope</string>
    <string name="chatbot_scope_all">Alle !-Befehle</string>
    <string name="chatbot_scope_mention">Nur Erwähnung</string>
    <string name="chatbot_scope_prefix">Eigenes Präfix</string>
    <string name="chatbot_scope_all_desc">Jeder !-Befehl wird beantwortet (Standard, wie der Bot von Moblin).</string>
    <string name="chatbot_scope_mention_desc">Nur Befehle, die den Bot direkt ansprechen (z. B. @vividbot !help) — generische Befehle bleiben dem anderen Bot.</string>
    <string name="chatbot_scope_prefix_desc">Nur Befehle mit eigenem Präfix (z. B. !v!help) — generische Befehle bleiben dem anderen Bot.</string>
    <string name="chatbot_prefix_label">Eigenes Befehls-Präfix (z. B. v → !v!help)</string>
    <string name="chatbot_owner_title">Owner-Zugriff (nur Streamer)</string>
    <string name="chatbot_owner_desc">Nur du (und eingetragene Logins) kannst während eines aktiven Streams die Owner-Befehle !start, !stop, !diag und !ask nutzen — Viewer sehen nur einen Hinweis. Der Kanal-Inhaber ist automatisch Owner (Broadcaster-Badge); trage hier zusätzliche Logins ein, z. B. deinen Zweitaccount.</string>
    <string name="chatbot_owner_logins_label">Owner-Logins (kommasepariert, ohne @)</string>
    <string name="chatbot_owner_llm_desc">Owner-KI (optional, exklusiv für Streamer-Befehle): !ask und die Diagnose-Empfehlungen von !diag laufen über diesen Endpunkt. Ohne eigene Owner-KI fallen die Befehle als Fallback auf die normale Bot-KI zurück (nur wenn auch die fehlt, liefert !diag die Checkliste direkt und !ask einen Hinweis).</string>
    <string name="chatbot_owner_llm_url_label">Owner-LLM API-Basis-URL (OpenAI-kompatibel)</string>
    <string name="chatbot_owner_llm_key_label">Owner-LLM API-Key</string>
    <string name="chatbot_owner_llm_model_label">Owner-LLM-Modell</string>
    <string name="chatbot_owner_source_label">KI-Quelle für Owner-Befehle: %1$s</string>
    <string name="owner_source_owner">eigene Owner-KI (exklusiv)</string>
    <string name="owner_source_owner_desc">!ask/!diag laufen über den hinterlegten Owner-LLM-Endpunkt — Viewer-Nachrichten erreichen ihn nie.</string>
    <string name="owner_source_viewer_fallback">Viewer-KI (Fallback)</string>
    <string name="owner_source_viewer_fallback_desc">Keine eigene Owner-KI hinterlegt — die Befehle nutzen die normale Bot-KI mit dem Owner-Kontext.</string>
    <string name="owner_source_deterministic">deterministisch (ohne KI)</string>
    <string name="owner_source_deterministic_desc">Weder Owner- noch Viewer-KI konfiguriert — !diag liefert die Checkliste direkt, !ask einen Hinweis.</string>
    <string name="chatbot_owner_whisper">Antworten privat senden (Whisper)</string>
    <string name="chatbot_owner_whisper_desc">Owner-Antworten (!start/!stop/!diag/!ask) kommen per Twitch-Whisper statt in den öffentlichen Chat. Dafür braucht der Bot-Token den Scope user:manage:whispers und die Twitch-App-Client-ID unten; schlägt der Whisper fehl (z. B. Empfänger blockt Fremde), antwortet der Bot öffentlich.</string>
    <string name="chatbot_client_id_label">Twitch-App-Client-ID (für Whisper)</string>
    <string name="chatbot_media_desc">Media-Befehle (!song / !next / !pause / !play / !prev) steuern den aktiven Musik-Player — dafür muss Vivid Benachrichtigungszugriff haben (liest keine Benachrichtigungen aus).</string>
    <string name="chatbot_notification_access_button">Benachrichtigungszugriff aktivieren</string>

