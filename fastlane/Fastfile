# Fastfile
default_platform(:android)

# Deterministischer versionCode aus einem Version-Tag (vX.Y.Z[-alpha|beta|rc]).
# Schema: major*1_000_000 + minor*1_000 + patch*10 + Stufe
# Stufe: alpha=1, beta=2, rc=3, stable=4 → wächst mit jeder Veröffentlichung.
# Bewusst NICHT von GITHUB_RUN_NUMBER abgeleitet: gleicher Tag ⇒ gleicher versionCode
# ⇒ gleiche APK (reproducible builds). Liefert nil bei unpassendem Format (Fallback).
def version_code_for(version_name)
  m = version_name.match(/^(\d+)\.(\d+)(?:\.(\d+))?(?:[-.]?(alpha|beta|rc))?/)
  return nil unless m
  major = m[1].to_i
  minor = m[2].to_i
  patch = (m[3] || "0").to_i
  stage = case m[4]
          when "alpha" then 1
          when "beta"  then 2
          when "rc"    then 3
          else 4
          end
  major * 1_000_000 + minor * 1_000 + patch * 10 + stage
end

platform :android do
  desc "Run all unit tests"
  lane :test do
    gradle(
      task: "testDebugUnitTest",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Build debug APK"
  lane :build_debug do
    gradle(
      task: "assembleDebug",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Build release APK"
  lane :build_release do
    gradle(
      task: "assembleRelease",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Run tests and build debug"
  lane :ci_debug do
    test
    build_debug
  end

  desc "Run tests and build release"
  lane :ci_release do
    test
    build_release
  end

  desc "Create and push an alpha release tag — runs tests, auto-versions, triggers CI"
  lane :release_alpha do |options|
    UI.header "Step 1/4: Running unit tests"
    test

    UI.header "Step 2/4: Checking branch"
    branch = `git rev-parse --abbrev-ref HEAD`.strip
    UI.user_error!("Must be on develop branch, current: #{branch}") unless branch == "develop"

    UI.header "Step 3/4: Determining version"
    tag = options[:version]
    unless tag
      latest = `git tag -l 'v*-alpha' --sort=-v:refname 2>/dev/null`.strip.lines.first&.strip
      if latest && !latest.empty?
        base = latest.sub(/^v/, "").sub(/-alpha$/, "")
        parts = base.split(".").map(&:to_i)
        tag = "v#{parts[0]}.#{parts[1] + 1}.0-alpha"
      else
        tag = "v0.2.0-alpha"
      end
    end
    tag = "v#{tag}" unless tag.start_with?("v")
    UI.message("Next alpha tag: #{tag}")

    # Safety: refuse to overwrite an existing tag
    if `git tag -l '#{tag}'`.strip != ""
      UI.user_error!("Tag #{tag} already exists — use version: to pick a different one")
    end

    UI.header "Step 4/4: Creating and pushing tag"
    sh("git", "tag", "-a", tag, "-m", "Alpha release #{tag}")
    sh("git", "push", "origin", tag)

    UI.success("✅ Pushed #{tag} — CI will build and publish the alpha release")
    UI.message("Monitor: https://github.com/thoser666/Vivid/actions")
  end

  desc "Build release APK and publish it as a GitHub release (requires gh + GH_TOKEN)"
  lane :release_github do |options|
    ref_type = ENV["GITHUB_REF_TYPE"].to_s # "tag" oder "branch"
    ref_name = ENV["GITHUB_REF_NAME"].to_s
    stable = options[:tag] || (ref_type == "tag" && ref_name.start_with?("v"))

    if stable
      version_name = (options[:tag] || ref_name).sub(/^v/, "")
      # Deterministisch aus dem Tag — NICHT aus GITHUB_RUN_NUMBER (bricht reproducible builds).
      version_code = version_code_for(version_name) || ENV["GITHUB_RUN_NUMBER"] || "1"
    else
      # Nur Version-Tags (v*) als Basis — nicht nightly-Tags, die täglich wandern.
      # Stufen-Suffix (-alpha/-beta/-rc) entfernen: v0.2.0-alpha → 0.2.0.
      base = `git describe --tags --abbrev=0 --match 'v*' 2>/dev/null`.strip.sub(/^v/, "").sub(/-(alpha|beta|rc)$/, "")
      base = "1.0" if base.empty?
      run_raw = ENV["GITHUB_RUN_NUMBER"] || "0"
      version_name = "#{base}-nightly.#{run_raw}"
      # Monoton steigend, kein Wrap nach 100.000 Runs (alt: % 100000).
      version_code = run_raw
    end

    gradle(
      task: "assembleRelease",
      flags: "--stacktrace --no-daemon",
      properties: {
        "versionName" => version_name,
        "versionCode" => version_code
      }
    )

    apk = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || "app/build/outputs/apk/release/app-release.apk"
    UI.message("APK path: #{apk}, exists: #{File.exist?(apk)}")
    publish_release(options.merge(apk: apk, version_name: version_name))
  end

  desc "Publish a pre-built release APK as a GitHub release (requires gh + GH_TOKEN, pre-built APK)"
  lane :publish_release do |options|
    apk = options[:apk] || lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || "app/build/outputs/apk/release/app-release.apk"
    ref_type = ENV["GITHUB_REF_TYPE"].to_s
    ref_name = ENV["GITHUB_REF_NAME"].to_s
    stable = options[:tag] || (ref_type == "tag" && ref_name.start_with?("v"))

    UI.user_error!("APK not found: #{apk}") unless File.exist?(apk)
    UI.message("APK: #{apk} (#{File.size(apk)} bytes)")

    if stable
      tag = options[:tag] || ref_name
      begin
        sh("gh", "release", "view", tag, "--json", "tagName")
        UI.important("Release #{tag} already exists - skipping")
      rescue
        UI.message("Publishing GitHub release #{tag}")
        sh("gh", "release", "create", tag, apk,
           "--title", "Vivid #{tag}",
           "--generate-notes")
      end
    else
      # Nur Version-Tags (v*) als Basis — nicht nightly-Tags, die täglich wandern.
      # Stufen-Suffix (-alpha/-beta/-rc) entfernen: v0.2.0-alpha → 0.2.0.
      base = `git describe --tags --abbrev=0 --match 'v*' 2>/dev/null`.strip.sub(/^v/, "").sub(/-(alpha|beta|rc)$/, "")
      base = "1.0" if base.empty?
      run_raw = ENV["GITHUB_RUN_NUMBER"] || "0"
      version_name = options[:version_name] || "#{base}-nightly.#{run_raw}"

      # Immutable Releases: every release gets a unique, date-based tag.
      # gh release create handles draft → upload → publish atomically.
      tag = "nightly-#{Time.now.utc.strftime('%Y%m%d-%H%M')}"
      notes = "Nightly feature build — installable via Obtainium (enable pre-releases)."
      UI.message("Publishing nightly prerelease #{version_name} → tag #{tag}")

      # Push the tag first (repo rules may block creation by gh release create alone)
      sh("git", "tag", tag)
      sh("git", "push", "origin", tag)

      # Create the release with the APK — gh internally does draft→upload→publish,
      # which is the only workflow compatible with immutable releases.
      UI.message("Creating nightly release with APK…")
      sh("gh", "release", "create", tag, apk,
         "--title", "Vivid nightly (#{version_name})",
         "--notes", notes,
         "--target", "develop",
         "--prerelease",
         "--latest=false")

      # Keep only the last 3 nightly releases to avoid clutter.
      # Delete release first, then the tag — immutable releases block tag
      # deletion while a release is still attached.
      UI.message("Cleaning old nightlys…")
      old_tags = `gh release list --limit 100 --json tagName,isPrerelease,createdAt --jq '[.[] | select(.isPrerelease and (.tagName | startswith("nightly-")))] | sort_by(.createdAt) | reverse | .[3:] | .[].tagName' 2>/dev/null`.strip.lines
      old_tags.each do |old_tag|
        old_tag = old_tag.strip
        next if old_tag.empty? || old_tag == tag
        UI.message("  Deleting old release: #{old_tag}")
        sh("gh", "release", "delete", old_tag, "--yes") rescue UI.message("  (release delete skipped)")
        UI.message("  Deleting old tag: #{old_tag}")
        sh("git", "push", "origin", ":refs/tags/#{old_tag}") rescue UI.message("  (tag delete skipped)")
      end
      UI.success("✅ Nightly published: #{tag}")
    end
  end
end