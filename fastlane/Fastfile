# Fastfile
require "json"
require "fileutils"
require_relative "stage_suffix"
require_relative "release_safety"
default_platform(:android)

platform :android do
  desc "Run all unit tests"
  lane :test do
    gradle(
      task: "testDebugUnitTest",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Run lint & static analysis on all modules"
  lane :lint do
    gradle(
      task: "lintDebug",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Build debug APK"
  lane :build_debug do
    gradle(
      task: "assembleDebug",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Build release APK"
  lane :build_release do
    gradle(
      task: "assembleRelease",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Run tests and build debug"
  lane :ci_debug do
    test
    build_debug
  end

  desc "Run tests and build release"
  lane :ci_release do
    test
    build_release
  end

  desc "Create and push an alpha release tag — runs tests, auto-versions, triggers CI"
  lane :release_alpha do |options|
    UI.header "Step 1/4: Running unit tests"
    test

    UI.header "Step 2/4: Checking branch"
    branch = `git rev-parse --abbrev-ref HEAD`.strip
    UI.user_error!("Must be on develop branch, current: #{branch}") unless branch == "develop"

    UI.header "Step 3/4: Determining version"
    tag = options[:version]
    unless tag
      latest = `git tag -l "v*-alpha" --sort=-v:refname 2>/dev/null`.strip.lines.first&.strip
      if latest && !latest.empty?
        base = latest.sub(/^v/, "").sub(/-alpha$/, "")
        parts = base.split(".").map(&:to_i)
        tag = "v#{parts[0]}.#{parts[1] + 1}.0-alpha"
      else
        tag = "v0.2.0-alpha"
      end
    end
    tag = "v#{tag}" unless tag.start_with?("v")

    # Suffix-Guard: Ein explizit übergebenes version: ohne '-alpha' würde einen
    # STABILEN Tag erzeugen (v0.5.1 statt v0.5.1-alpha — Vorfall 18.08.2026, siehe
    # RELEASE.md → Alpha-Strategie). Invariante: Alpha-Tags enden immer auf '-alpha'.
    unless stage_suffix_ok?(tag, "alpha")
      UI.user_error!("Tag #{tag} ist kein gültiger Alpha-Tag (Suffix '-alpha' fehlt). Explizites version: muss den vollen Tag inkl. Stufe enthalten, z. B. version:v0.5.1-alpha — sonst entstünde ein stabiler Tag.")
    end

    # Safety 5 (Versicherung, geteilt mit release_beta): Roadmap-Reservierung —
    # v0.6.0-beta ist für das Streaming-Erweiterungs-Bucket reserviert (RELEASE.md →
    # Roadmap → Nummerierung). Solange das Bucket in PARITY.md nicht implementiert
    # ist, darf der Tag nicht belegt werden — sonst kollidiert die Nummerierung mit
    # dem späteren Feature-Bucket.
    reservation = reserved_roadmap_reason(tag)
    if reservation
      UI.user_error!("Tag #{tag} ist reserviert: #{reservation} — erst nach Implementierung des Buckets verwenden (siehe RELEASE.md → Roadmap → Nummerierung).")
    end

    # Safety 2–4 (geteilt mit release_beta, siehe fastlane/release_safety.rb):
    # versionCode ableitbar · kein Downgrade innerhalb der alpha-Track · Quer-Track-Hinweis.
    all_tags = `git tag -l "v*" 2>/dev/null`.lines

    # Safety 2 (Versicherung): deterministischer versionCode aus dem Tag ableiten —
    # ist das nicht möglich (falsches Format), darf kein Tag gepusht werden.
    code = version_code_for(tag.sub(/^v/, ""))
    if code.nil?
      UI.user_error!("Could not derive versionCode from #{tag} — expected format vX.Y.Z[-alpha]")
    end

    # Safety 3 (Versicherung): kein Downgrade innerhalb der alpha-Track — der neue
    # versionCode muss strikt größer sein als der höchste bisher veröffentlichte alpha-Code.
    last_stage_code = highest_stage_code(all_tags, "alpha")
    if last_stage_code && code <= last_stage_code
      UI.user_error!("versionCode #{code} is not greater than the last alpha release (#{last_stage_code}) — use version: to pick a higher one")
    end

    # Safety 4 (Versicherung): Quer-Track-Hinweis statt Abbruch — Warnung greift nur,
    # wenn jemand bewusst ein niedrigeres version: übergibt — Android blockt Downgrades,
    # deren Nutzer müssen die App dann vorher deinstallieren.
    max_other = highest_other_code(all_tags, tag)
    if max_other && code < max_other
      UI.important("⚠️ #{tag} (#{code}) hat einen kleineren versionCode als das letzte Release anderer Tracks (#{max_other}) — deren Nutzer müssen die App vorher deinstallieren (Android-Downgrade-Block).")
    end

    UI.message("Next alpha tag: #{tag}")

    # Safety: refuse to overwrite an existing tag
    if `git tag -l "#{tag}"`.strip != ""
      UI.user_error!("Tag #{tag} already exists — use version: to pick a different one")
    end

    UI.header "Step 4/4: Creating and pushing tag"
    sh("git", "tag", "-a", tag, "-m", "Alpha release #{tag}")
    sh("git", "push", "origin", tag)

    UI.success("✅ Pushed #{tag} — CI will build and publish the alpha release")
    UI.message("Monitor: https://github.com/thoser666/Vivid/actions")
  end

  desc "Create and push a beta release tag — runs tests, auto-versions, triggers CI (mirror of release_alpha, stage beta)"
  lane :release_beta do |options|
    UI.header "Step 1/5: Running unit tests"
    test

    UI.header "Step 2/5: Checking branch"
    branch = `git rev-parse --abbrev-ref HEAD`.strip
    UI.user_error!("Must be on develop branch, current: #{branch}") unless branch == "develop"

    UI.header "Step 3/5: Determining version"
    tag = options[:version]
    unless tag
      latest = `git tag -l "v*-beta" --sort=-v:refname 2>/dev/null`.strip.lines.first&.strip
      if latest && !latest.empty?
        base = latest.sub(/^v/, "").sub(/-beta$/, "")
        parts = base.split(".").map(&:to_i)
        tag = "v#{parts[0]}.#{parts[1] + 1}.0-beta"
      else
        # Erster Beta-Tag: vom höchsten existierenden v*-Tag ableiten (Stufe auf beta),
        # damit der versionCode direkt über dem letzten Alpha liegt — v0.5.0-alpha
        # (5001) → v0.5.0-beta (5002), kein Quer-Track-Downgrade.
        latest_any = `git tag -l "v*" --sort=-v:refname 2>/dev/null`.strip.lines.first&.strip
        tag = latest_any&.sub(/-(alpha|rc)$/, "-beta")
        unless tag&.match?(/^v\d+\.\d+\.\d+-beta$/)
          # Fallback (z. B. nur nightly-*-Tags vorhanden): Plan aus RELEASE.md.
          tag = "v0.5.0-beta"
        end
      end
    end
    tag = "v#{tag}" unless tag.start_with?("v")

    # Suffix-Guard: Ein explizit übergebenes version: ohne '-beta' würde einen
    # STABILEN Tag erzeugen (v0.5.1 statt v0.5.1-beta — Vorfall 18.08.2026, siehe
    # RELEASE.md → Beta-Strategie). Invariante: Beta-Tags enden immer auf '-beta'.
    unless stage_suffix_ok?(tag, "beta")
      UI.user_error!("Tag #{tag} ist kein gültiger Beta-Tag (Suffix '-beta' fehlt). Explizites version: muss den vollen Tag inkl. Stufe enthalten, z. B. version:v0.5.1-beta — sonst entstünde ein stabiler Tag.")
    end
    UI.message("Next beta tag: #{tag}")

    # Safety 1: refuse to overwrite an existing tag
    if `git tag -l "#{tag}"`.strip != ""
      UI.user_error!("Tag #{tag} already exists — use version: to pick a different one")
    end

    # Safety 5 (Versicherung, geteilt mit release_alpha): Roadmap-Reservierung —
    # v0.6.0-beta ist für das Streaming-Erweiterungs-Bucket reserviert (RELEASE.md →
    # Roadmap → Nummerierung). Solange das Bucket in PARITY.md nicht implementiert
    # ist, darf der Tag nicht belegt werden — sonst kollidiert die Nummerierung mit
    # dem späteren Feature-Bucket.
    reservation = reserved_roadmap_reason(tag)
    if reservation
      UI.user_error!("Tag #{tag} ist reserviert: #{reservation} — erst nach Implementierung des Buckets verwenden (siehe RELEASE.md → Roadmap → Nummerierung).")
    end

    # Safety 2–4 (geteilt mit release_alpha, siehe fastlane/release_safety.rb):
    # versionCode ableitbar · kein Downgrade innerhalb der beta-Track · Quer-Track-Hinweis.
    all_tags = `git tag -l "v*" 2>/dev/null`.lines

    # Safety 2 (Versicherung): deterministischer versionCode aus dem Tag ableiten —
    # ist das nicht möglich (falsches Format), darf kein Tag gepusht werden.
    code = version_code_for(tag.sub(/^v/, ""))
    if code.nil?
      UI.user_error!("Could not derive versionCode from #{tag} — expected format vX.Y.Z[-beta]")
    end

    # Safety 3 (Versicherung): kein Downgrade innerhalb der beta-Track — der neue
    # versionCode muss strikt größer sein als der höchste bisher veröffentlichte beta-Code.
    last_stage_code = highest_stage_code(all_tags, "beta")
    if last_stage_code && code <= last_stage_code
      UI.user_error!("versionCode #{code} is not greater than the last beta release (#{last_stage_code}) — use version: to pick a higher one")
    end

    # Safety 4 (Versicherung): Quer-Track-Hinweis statt Abbruch — Warnung greift nur,
    # wenn jemand bewusst ein niedrigeres version: übergibt — Android blockt Downgrades,
    # deren Nutzer müssen die App dann vorher deinstallieren.
    max_other = highest_other_code(all_tags, tag)
    if max_other && code < max_other
      UI.important("⚠️ #{tag} (#{code}) hat einen kleineren versionCode als das letzte Release anderer Tracks (#{max_other}) — deren Nutzer müssen die App vorher deinstallieren (Android-Downgrade-Block).")
    end

    UI.header "Step 4/5: Creating and pushing tag"
    sh("git", "tag", "-a", tag, "-m", "Beta release #{tag}")
    sh("git", "push", "origin", tag)

    UI.header "Step 5/5: Done"
    UI.success("✅ Pushed #{tag} — CI will build and publish the beta release")
    UI.message("Monitor: https://github.com/thoser666/Vivid/actions")
  end

  desc "Build release APK and publish it as a GitHub release (requires gh + GH_TOKEN)"
  lane :release_github do |options|
    ref_type = ENV["GITHUB_REF_TYPE"].to_s # "tag" oder "branch"
    ref_name = ENV["GITHUB_REF_NAME"].to_s
    stable = options[:tag] || (ref_type == "tag" && ref_name.start_with?("v"))

    if stable
      version_name = (options[:tag] || ref_name).sub(/^v/, "")
      # Deterministisch aus dem Tag — NICHT aus GITHUB_RUN_NUMBER (bricht reproducible builds).
      version_code = version_code_for(version_name) || ENV["GITHUB_RUN_NUMBER"] || "1"
    else
      # Nur Version-Tags (v*) als Basis — nicht nightly-Tags, die täglich wandern.
      # Stufen-Suffix (-alpha/-beta/-rc) entfernen: v0.2.0-alpha → 0.2.0.
      base = `git describe --tags --abbrev=0 --match "v*" 2>/dev/null`.strip.sub(/^v/, "").sub(/-(alpha|beta|rc)$/, "")
      base = "1.0" if base.empty?
      run_raw = ENV["GITHUB_RUN_NUMBER"] || "0"
      version_name = "#{base}-nightly.#{run_raw}"
      # Monoton steigend, kein Wrap nach 100.000 Runs (alt: % 100000).
      version_code = run_raw
    end

    gradle(
      task: "assembleRelease",
      flags: "--stacktrace --no-daemon",
      properties: {
        "versionName" => version_name,
        "versionCode" => version_code
      }
    )

    # Sentry: Das Gradle-Plugin (autoUploadProguardMapping) lädt die ProGuard-Mapping
    # Datei bereits automatisch bei jedem Release-Build hoch — mit der UUID, die es
    # ins Manifest schreibt. Genau diese UUID-Verknüpfung aktiviert die Deobfuskation
    # in Sentry; ein manueller sentry-cli-Upload ohne diese UUID wäre wirkungslos.
    # Wichtig: SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN müssen im CI-Job gesetzt
    # sein (android_fastlane.yml publish-release), sonst wird der Upload übersprungen.
    UI.message("Sentry mapping upload: Gradle plugin autoUploadProguardMapping=#{ENV["SENTRY_AUTH_TOKEN"] ? true : false}") if ENV["SENTRY_AUTH_TOKEN"]

    apk = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || "app/build/outputs/apk/release/app-release.apk"
    UI.message("APK path: #{apk}, exists: #{File.exist?(apk)}")
    publish_release(options.merge(apk: apk, version_name: version_name))
  end

  desc "Publish a pre-built release APK as a GitHub release (requires gh + GH_TOKEN, pre-built APK)"
  lane :publish_release do |options|
    apk = options[:apk] || lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || "app/build/outputs/apk/release/app-release.apk"
    ref_type = ENV["GITHUB_REF_TYPE"].to_s
    ref_name = ENV["GITHUB_REF_NAME"].to_s
    stable = options[:tag] || (ref_type == "tag" && ref_name.start_with?("v"))

    UI.user_error!("APK not found: #{apk}") unless File.exist?(apk)
    UI.message("APK: #{apk} (#{File.size(apk)} bytes)")

    if stable
      tag = options[:tag] || ref_name
      # Härtung: Bestehendes Release nur dann akzeptieren, wenn es vollständig
      # ist (published, kein Draft, APK-Asset vorhanden). Ein halb erstelltes
      # Release aus einem abgebrochenen Run (z. B. Draft ohne Assets, Upload
      # mitten in der Kette gestorben) darf einen Re-Run NICHT blockieren —
      # sonst würde der Job stillschweigend grün enden, ohne dass eine
      # installierbare APK veröffentlicht wurde.
      existing = `gh release view #{tag} --json isDraft,assets 2>/dev/null`.strip
      info = JSON.parse(existing) rescue nil
      if info && !info["isDraft"] && (info["assets"] || []).any? { |a| a.is_a?(Hash) && (a["name"] || "").end_with?(".apk") }
        UI.important("Release #{tag} already exists and is complete - skipping")
      else
        if info
          UI.important("Release #{tag} exists but is incomplete (draft or missing APK) - deleting and recreating")
          sh("gh", "release", "delete", tag, "--yes") rescue UI.message("  (kein Release zu löschen — ok)")
        end
        UI.message("Publishing GitHub release #{tag}")
        # Härtung: Retry gegen transiente Fehler (Netz/API) — Spiegel des
        # nightly-Pfads. Bei endgültigem Fehler KEIN Tag-Rollback: Der Tag ist
        # absichtlich von der Release-Lane gepusht (Versionierung, Re-Run-
        # Trigger) und damit kein Wegwerf-Artefakt wie nightly-Tags. Bereinigt
        # wird nur ein evtl. zurückgebliebenes (Draft-)Release, damit ein
        # Re-Run nicht in die "exists - skipping"-Falle läuft.
        attempts = 0
        begin
          attempts += 1
          sh("gh", "release", "create", tag, apk,
             "--title", "Vivid #{tag}",
             "--generate-notes")
        rescue => e
          if attempts < 3
            UI.important("gh release create fehlgeschlagen (Versuch #{attempts}/3) — retry: #{e.message}")
            sleep 5
            retry
          end
          UI.error("Release-Erstellung endgültig fehlgeschlagen — Rest-Release wird bereinigt, Tag #{tag} bleibt erhalten")
          begin
            sh("gh", "release", "delete", tag, "--yes")
            UI.message("  (Rest-Release #{tag} gelöscht)")
          rescue
            UI.message("  (kein Release zu löschen — ok)")
          end
          raise
        end
      end
    else
      # Nur Version-Tags (v*) als Basis — nicht nightly-Tags, die täglich wandern.
      # Stufen-Suffix (-alpha/-beta/-rc) entfernen: v0.2.0-alpha → 0.2.0.
      base = `git describe --tags --abbrev=0 --match "v*" 2>/dev/null`.strip.sub(/^v/, "").sub(/-(alpha|beta|rc)$/, "")
      base = "1.0" if base.empty?
      run_raw = ENV["GITHUB_RUN_NUMBER"] || "0"
      version_name = options[:version_name] || "#{base}-nightly.#{run_raw}"

      # Immutable Releases: every release gets a unique, date-based tag.
      # Sekunden-Granularität: eliminiert Kollisionen mit Orphan-Tags gleichen
      # Namens aus abgebrochenen Runs (Minuten-Granularität konnte kollidieren).
      # gh release create handles draft → upload → publish atomically.
      tag = "nightly-#{Time.now.utc.strftime('%Y%m%d-%H%M%S')}"
      notes = "Nightly feature build — installable via Obtainium (enable pre-releases)."
      UI.message("Publishing nightly prerelease #{version_name} → tag #{tag}")

      # Push the tag first (repo rules may block creation by gh release create alone).
      # WICHTIG: Der Tag zeigt auf den AKTUELLEN develop-HEAD (frisch gefetch), nicht
      # auf den möglicherweise veralteten Checkout-Commit. Ein Tag auf einem älteren
      # Commit, dessen Baum sich in .github/workflows vom develop unterscheidet, wird
      # vom GITHUB_TOKEN ohne "workflows"-Berechtigung abgelehnt ("refusing to allow
      # a GitHub App to create or update workflow"). Diese Berechtigung darf der
      # Workflow aber NICHT deklarieren (Push-getriggerte Runs scheitern dann an der
      # Validierung) — mit dem aktuellen develop-HEAD gibt es keinen Workflow-Diff.
      sh("git", "fetch", "origin", "develop")
      sh("git", "tag", tag, "origin/develop")

      # Härtung: existiert der Tag remote bereits (Orphan-Rest eines abgebrochenen
      # Runs), NICHT still überschreiben — laut abbrechen. Der Orphan-Tag-Sweep im
      # Cleanup-Schritt räumt solche Reste beim nächsten erfolgreichen Run auf.
      unless `git ls-remote --tags origin "refs/tags/#{tag}" 2>/dev/null`.strip.empty?
        UI.user_error!("Tag #{tag} existiert bereits remote (Orphan eines abgebrochenen Runs?) — manuell prüfen: gh release view #{tag}; ggf. git push origin :refs/tags/#{tag}")
      end
      sh("git", "push", "origin", tag)

      # Create the release with the APK (plus mapping & metadata for
      # reproducibility checks) — gh internally does draft→upload→publish,
      # which is the only workflow compatible with immutable releases.
      # Absolute Pfade aus der gradle-Action bevorzugen (wie beim APK) —
      # relative Pfade scheitern in der CI, weil fastlane dort nicht aus
      # dem Repo-Root läuft (File.exist? lieferte false, Assets fehlten).
      UI.message("Creating nightly release…")
      mapping = lane_context[SharedValues::GRADLE_MAPPING_TXT_OUTPUT_PATH] || ENV["GRADLE_MAPPING_TXT_OUTPUT_PATH"] || "app/build/outputs/mapping/release/mapping.txt"
      metadata = lane_context[SharedValues::GRADLE_OUTPUT_JSON_OUTPUT_PATH] || ENV["GRADLE_OUTPUT_JSON_OUTPUT_PATH"] || "app/build/outputs/apk/release/output-metadata.json"
      assets = [apk]
      assets << mapping if File.exist?(mapping)
      assets << metadata if File.exist?(metadata)
      UI.message("  assets: #{assets.map { |a| File.basename(a) }.join(', ')}")
      UI.message("  mapping: #{mapping} exists=#{File.exist?(mapping)}") if mapping
      UI.message("  metadata: #{metadata} exists=#{File.exist?(metadata)}") if metadata
      # Härtung: Retry gegen transiente Fehler (Netz/API); bei endgültigem Fehler
      # Rollback — evtl. angelegtes (Draft-)Release und den soeben gepushten Tag
      # wieder löschen, damit KEIN Orphan-Tag zurückbleibt. Danach erneut werfen.
      attempts = 0
      begin
        attempts += 1
        sh("gh", "release", "create", tag, *assets,
           "--title", "Vivid nightly (#{version_name})",
           "--notes", notes,
           "--target", "develop",
           "--prerelease",
           "--latest=false")
      rescue => e
        if attempts < 3
          UI.important("gh release create fehlgeschlagen (Versuch #{attempts}/3) — retry: #{e.message}")
          sleep 5
          retry
        end
        UI.error("Release-Erstellung endgültig fehlgeschlagen — Rollback von Tag/Release #{tag}")
        begin
          sh("gh", "release", "delete", tag, "--yes")
          UI.message("  (Rest-Release #{tag} gelöscht)")
        rescue
          UI.message("  (kein Release zu löschen — ok)")
        end
        begin
          sh("git", "push", "origin", ":refs/tags/#{tag}")
          UI.message("  (Orphan-Tag #{tag} gelöscht)")
        rescue
          UI.message("  (Tag-Löschung fehlgeschlagen — manuell: git push origin :refs/tags/#{tag})")
        end
        raise
      end

      # Keep only the last 3 nightly releases to avoid clutter.
      # Delete release first, then the tag — immutable releases block tag
      # deletion while a release is still attached.
      UI.message("Cleaning old nightlys…")
      old_tags = `gh release list --limit 100 --json tagName,isPrerelease,createdAt --jq '[.[] | select(.isPrerelease and (.tagName | startswith("nightly-")))] | sort_by(.createdAt) | reverse | .[3:] | .[].tagName' 2>/dev/null`.strip.lines
      old_tags.each do |old_tag|
        old_tag = old_tag.strip
        next if old_tag.empty? || old_tag == tag
        UI.message("  Deleting old release: #{old_tag}")
        sh("gh", "release", "delete", old_tag, "--yes") rescue UI.message("  (release delete skipped)")
        UI.message("  Deleting old tag: #{old_tag}")
        sh("git", "push", "origin", ":refs/tags/#{old_tag}") rescue UI.message("  (tag delete skipped)")
      end

      # Härtung (Selbstheilung): Orphan-Tags bereinigen — nightly-* Tags ohne
      # Release (Rest aus abgebrochenen Runs: Tag gepusht, Release-Erstellung
      # fehlgeschlagen/abgebrochen). Der release-basierte Cleanup oben sieht sie
      # nicht; ohne diesen Sweep sammeln sie sich dauerhaft an.
      UI.message("Sweeping orphan nightly tags (kein Release)…")
      orphans = `git ls-remote --tags origin "refs/tags/nightly-*" 2>/dev/null`.strip.lines
        .map { |l| l.split("refs/tags/").last&.strip }
        .compact
        .reject { |t| t.empty? || t.end_with?("^{}") || t == tag }
      orphans.each do |orphan|
        has_release = `gh release view #{orphan} --json tagName 2>/dev/null`.strip != ""
        next if has_release
        UI.message("  Orphan-Tag ohne Release: #{orphan} → lösche")
        sh("git", "push", "origin", ":refs/tags/#{orphan}") rescue UI.message("  (orphan tag delete skipped)")
      end
      UI.success("✅ Nightly published: #{tag}")
    end
  end

  desc "Build a release AAB signed with the UPLOAD key and upload it to Google Play (requires UPLOAD_KEYSTORE_* + Play service-account credentials; dry_run:true baut + verifiziert ohne Upload)"
  lane :publish_play do |options|
    # Dry-Run: baut + signaturverifiziert, aber ueberspringt den supply-Upload.
    # dry_run:true eignet sich zum Testen der Pipeline ohne Play-Auswirkung.
    dry_run = options[:dry_run].to_s == "true"
    UI.message("DRY RUN aktiv - kein Upload nach Google Play") if dry_run

    UI.header "Step 1/6: Checking credentials"
    UI.user_error!("UPLOAD_KEYSTORE_PATH must be set (Play upload keystore)") if ENV["UPLOAD_KEYSTORE_PATH"].to_s.empty?
    UI.user_error!("UPLOAD_KEYSTORE_PASSWORD must be set") if ENV["UPLOAD_KEYSTORE_PASSWORD"].to_s.empty?
    UI.user_error!("UPLOAD_KEY_ALIAS must be set") if ENV["UPLOAD_KEY_ALIAS"].to_s.empty?
    UI.user_error!("UPLOAD_KEY_PASSWORD must be set") if ENV["UPLOAD_KEY_PASSWORD"].to_s.empty?
    unless dry_run
      if ENV["PLAY_JSON_KEY_FILE"].to_s.empty? && ENV["PLAY_JSON_KEY_DATA"].to_s.empty?
        UI.user_error!("Play service-account credentials missing - set PLAY_JSON_KEY_FILE (path) or PLAY_JSON_KEY_DATA (json content), see https://docs.fastlane.tools/actions/supply/")
      end
    end

    UI.header "Step 2/6: Determining version"
    # Deterministisch aus dem letzten Version-Tag (v*) - NICHT aus GITHUB_RUN_NUMBER.
    # versionCode muss in Play global eindeutig sein (pro App nur einmal hochladbar):
    # gleicher Tag => gleicher Code; mit version:/version_code: kann bewusst ein
    # anderer Wert erzwungen werden.
    describe = `git describe --tags --abbrev=0 --match "v*" 2>/dev/null`.strip.sub(/^v/, "")
    version_name = options[:version] || (describe.empty? ? "1.0" : describe)
    version_code = options[:version_code] || version_code_for(version_name) || ENV["GITHUB_RUN_NUMBER"] || "1"
    track = options[:track] || "alpha"
    UI.message("Play upload: #{version_name} (#{version_code}) -> track #{track}")

    UI.header "Step 3/6: Building AAB with UPLOAD key"
    gradle(
      task: "bundlePlayRelease",
      flags: "--stacktrace --no-daemon",
      properties: {
        "versionName" => version_name,
        "versionCode" => version_code
      }
    )
    aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH] || "app/build/outputs/bundle/playRelease/app-playRelease.aab"
    UI.user_error!("AAB not found: #{aab}") unless File.exist?(aab)
    UI.message("AAB: #{aab} (#{File.size(aab)} bytes)")

    UI.header "Step 4/6: Verifying AAB signature against UPLOAD key"
    keystore = ENV["UPLOAD_KEYSTORE_PATH"]
    aab_fp = `keytool -printcert -jarfile "#{aab}" 2>/dev/null | grep '^[[:space:]]*SHA256:' | head -1 | sed 's/.*SHA256:[[:space:]]*//' | tr -d ':' | tr '[:upper:]' '[:lower:]'`.strip
    key_fp = `keytool -list -v -keystore "#{keystore}" -storepass "#{ENV["UPLOAD_KEYSTORE_PASSWORD"]}" -alias "#{ENV["UPLOAD_KEY_ALIAS"]}" 2>/dev/null | grep '^[[:space:]]*SHA256:' | sed 's/.*SHA256:[[:space:]]*//' | tr -d ':' | tr '[:upper:]' '[:lower:]'`.strip
    UI.message("AAB signer SHA-256: #{aab_fp}")
    UI.message("Upload key SHA-256: #{key_fp}")
    UI.user_error!("Signature mismatch: AAB is not signed with the UPLOAD key") if aab_fp.empty? || key_fp.empty? || aab_fp != key_fp
    UI.success("AAB signature verified against UPLOAD key")

    if dry_run
      UI.header "Step 5/6: DRY RUN - skipping Play upload"
      UI.message("AAB ready: #{aab} (#{File.size(aab)} bytes)")
      UI.message("Upload uebersprungen (dry_run=true) - nichts wurde an Google Play uebertragen")
    else
      UI.header "Step 5/6: Uploading to Google Play (track #{track})"
      supply_opts = {
        aab: aab,
        track: track,
        metadata_path: "fastlane/metadata/android",
        skip_upload_apk: true
      }
      supply_opts[:json_key_file] = ENV["PLAY_JSON_KEY_FILE"] if ENV["PLAY_JSON_KEY_FILE"].to_s != ""
      supply_opts[:json_key] = ENV["PLAY_JSON_KEY_DATA"] if ENV["PLAY_JSON_KEY_DATA"].to_s != ""
      supply(supply_opts)
    end

    UI.header "Step 6/6: Done"
    if dry_run
      UI.success("DRY RUN abgeschlossen: AAB gebaut + Signatur verifiziert, kein Upload")
    else
      UI.success("Uploaded #{version_name} to Play track #{track}")
      UI.message("Release in der Play Console veroeffentlichen: App -> Release -> 'Go live'")
    end
  end

  desc "Report orphaned draft releases on v* tags (no auto-delete - a draft may be intentional)"
  lane :sweep_orphan_drafts do
    UI.header "Scanning v* releases for orphaned drafts…"
    # Ein Draft auf einem v*-Tag ist der Rest eines abgebrochenen Stable-Runs:
    # der Rollback im publish-release-Job (publish_release-Lane) kann bei hartem
    # Runner-Kill nicht mehr laufen. Drafts werden nur GEMELDET, nie automatisch
    # gelöscht — ein menschlich angelegter Draft (geplante Veröffentlichung) ist
    # legitim. Der Job läuft auf Schedule/Manual, nicht auf Push: während
    # publish-release parallel ein Release neu erstellt, wäre eine Meldung
    # transient und irreführend.
    # Achtung: gh release list akzeptiert NUR die Felder createdAt/isDraft/isImmutable/
    # isLatest/isPrerelease/name/publishedAt/tagName — "url" gibt es nur bei
    # gh release view. Die Release-URL wird deshalb unten aus dem Tag gebaut.
    rows = `gh release list --limit 100 --json tagName,isDraft,name,createdAt 2>/dev/null`.strip
    releases = JSON.parse(rows) rescue []
    if releases.empty?
      UI.important("Keine Releases gefunden (gh nicht verfügbar / GH_TOKEN fehlt?) — Sweep übersprungen")
    else
      drafts = releases.select { |r| (r["tagName"] || "").match?(/^v\d+\.\d+/) && r["isDraft"] }
      if drafts.empty?
        UI.success("✅ Keine verwaisten Draft-Releases auf v*-Tags gefunden (#{releases.size} Releases geprüft)")
      else
        UI.error("⚠️ #{drafts.size} verwaiste(s) Draft-Release(s) auf v*-Tags gefunden:")
        drafts.each do |d|
          UI.error("  - #{d["tagName"]} (#{d["name"]}) created #{d["createdAt"]} — https://github.com/thoser666/Vivid/releases/tag/#{d["tagName"]}")
        end
        UI.error("Auflösung (manuell): veröffentlichen → gh release edit <tag> --draft=false; oder löschen → gh release delete <tag> --yes")
        UI.user_error!("Orphaned draft release(s) found on v* tags — resolve manually, see above")
      end
    end
  end

  desc "Capture the two Play Store screenshots via UI tests (fastlane screengrab) — requires a running emulator/device; replaces the placeholder PNGs under fastlane/metadata/android/images/phoneScreenshots/ and verifies the metadata gate"
  lane :capture_play_screenshots do
    # WICHTIG: fastlane läuft mit cwd = fastlane/ (Verzeichnis der Fastfile). Alle
    # Pfade deshalb explizit vom Projekt-Root ableiten — relative Pfade landeten
    # sonst in fastlane/fastlane/... (verschachtelt) und das Gate prüfte die
    # falschen Dateien.
    root = File.expand_path("..", __dir__)
    shots_dir = File.join(root, "fastlane/screenshots/en-US/images/phoneScreenshots")
    meta_dir = File.join(root, "fastlane/metadata/android/images/phoneScreenshots")

    UI.header "Step 1/3: Building debug + androidTest APKs"
    gradle(task: "clean assembleDebug assembleDebugAndroidTest")

    UI.header "Step 2/3: Capturing screenshots (fastlane screengrab)"
    # Library-only setup (tools.fastlane:screengrab, KEIN Screengrab-Gradle-Plugin —
    # das alte Plugin ist mit AGP 9 nicht kompatibel). Die Action installiert die
    # APKs selbst, instrumentiert nur PlayScreenshotsTest (use_tests_in_classes)
    # und zieht die PNGs vom Geraet nach fastlane/screenshots/<locale>/images/phoneScreenshots/.
    # use_timestamp_suffix:false → stabile Dateinamen (1_live_stream.png, 2_settings.png).
    screengrab(
      app_apk_path: "app/build/outputs/apk/debug/app-debug.apk",
      tests_apk_path: "app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
      app_package_name: "com.vivid.debug",
      tests_package_name: "com.vivid.debug.test",
      locales: ["en-US"],
      use_tests_in_classes: ["com.vivid.irlbroadcaster.PlayScreenshotsTest"],
      clear_previous_screenshots: true,
      use_timestamp_suffix: false,
      output_directory: File.join(root, "fastlane/screenshots"),
      exit_on_test_failure: true
    )

    UI.header "Step 3/3: Copying into metadata (supply naming) + verifying"
    # Windows-Fallback: screengrabs run-as-tar-Pull scheitert unter Git-Bash/cmd.exe
    # (toybox-tar-Pipe bricht ab). Dann die PNGs direkt per adb exec-out run-as cat
    # vom Gerät streamen — identische Bytes, kein Zwischenschritt über /sdcard.
    if !File.exist?(File.join(shots_dir, "1_live_stream.png")) || !File.exist?(File.join(shots_dir, "2_settings.png"))
      UI.important("Screenshots fehlen lokal — Pull-Fallback über adb exec-out run-as cat")
      FileUtils.mkdir_p(shots_dir)
      ["1_live_stream.png", "2_settings.png"].each do |name|
        sh "adb exec-out run-as com.vivid.debug cat app_screengrab/en-US/images/screenshots/#{name} > #{File.join(shots_dir, name)}"
      end
    end
    mapping = {
      "1_live_stream.png" => "1_en-US.png",
      "2_settings.png"    => "2_en-US.png"
    }
    FileUtils.mkdir_p(meta_dir)
    mapping.each do |src, dst|
      src_path = File.join(shots_dir, src)
      UI.user_error!("Screenshot fehlt: #{src_path}") unless File.exist?(src_path)
      FileUtils.cp(src_path, File.join(meta_dir, dst))
      UI.success("✅ #{src} → #{dst}")
    end
    # Array-Form + absolute Skriptpfade + METADATA_DIR/README_FILE explizit:
    # fastlanes String-sh mit relativen Pfaden scheitert unter Windows
    # (cwd = fastlane/, bash-Auflösung WSL vs. Git-bash) — so ist der Check
    # cwd-unabhängig. README_FILE muss auf das Projekt-Root zeigen, sonst
    # sucht der README↔Play-Konsistenz-Guard die README relativ zu fastlane/.
    sh({ "METADATA_DIR" => File.join(root, "fastlane/metadata/android"),
         "README_FILE" => File.join(root, "README.md") },
       "bash", File.join(root, "scripts/check_play_metadata.sh"))
    UI.success("Screenshots regeneriert — Platzhalter ersetzt, Metadaten-Gate grün")
  end
end