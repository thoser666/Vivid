    <string name="privacy_section_title">Privacy &amp; error reports</string>
    <string name="privacy_sentry_toggle">Send error reports (Sentry)</string>
    <string name="privacy_sentry_desc">Sends error reports to Sentry on crashes (default: on). No screenshots are taken; device/IP information is disabled. Off = nothing is transmitted to Sentry. Details: PRIVACY.md in the repository.</string>

