# Fastfile
default_platform(:android)

platform :android do
  desc "Run all unit tests"
  lane :test do
    gradle(
      task: "testDebugUnitTest",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Build debug APK"
  lane :build_debug do
    gradle(
      task: "assembleDebug",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Build release APK"
  lane :build_release do
    gradle(
      task: "assembleRelease",
      flags: "--stacktrace --no-daemon"
    )
  end

  desc "Run tests and build debug"
  lane :ci_debug do
    test
    build_debug
  end

  desc "Run tests and build release"
  lane :ci_release do
    test
    build_release
  end

  desc "Build release APK and publish it as a GitHub release (requires gh + GH_TOKEN)"
  lane :release_github do |options|
    ref_type = ENV["GITHUB_REF_TYPE"].to_s # "tag" oder "branch"
    ref_name = ENV["GITHUB_REF_NAME"].to_s
    stable = options[:tag] || (ref_type == "tag" && ref_name.start_with?("v"))

    if stable
      version_name = (options[:tag] || ref_name).sub(/^v/, "")
      version_code = ENV["GITHUB_RUN_NUMBER"] || "1"
    else
      base = `git describe --tags --abbrev=0 2>/dev/null`.strip.sub(/^v/, "")
      base = "1.0" if base.empty?
      run_raw = ENV["GITHUB_RUN_NUMBER"] || "0"
      version_name = "#{base}-nightly.#{run_raw}"
      version_code = (run_raw.to_i % 100000).to_s
    end

    gradle(
      task: "assembleRelease",
      flags: "--stacktrace --no-daemon",
      properties: {
        "versionName" => version_name,
        "versionCode" => version_code
      }
    )

    apk = "app/build/outputs/apk/release/app-release.apk"
    UI.message("APK path: #{apk}, exists: #{File.exist?(apk)}")
    publish_release(options.merge(apk: apk, version_name: version_name))
  end

  desc "Publish a pre-built release APK as a GitHub release (requires gh + GH_TOKEN, pre-built APK)"
  lane :publish_release do |options|
    apk = options[:apk] || "app/build/outputs/apk/release/app-release.apk"
    ref_type = ENV["GITHUB_REF_TYPE"].to_s
    ref_name = ENV["GITHUB_REF_NAME"].to_s
    stable = options[:tag] || (ref_type == "tag" && ref_name.start_with?("v"))

    UI.user_error!("APK not found: #{apk}") unless File.exist?(apk)
    UI.message("APK: #{apk} (#{File.size(apk)} bytes)")

    if stable
      tag = options[:tag] || ref_name
      begin
        sh("gh", "release", "view", tag, "--json", "tagName")
        UI.important("Release #{tag} already exists - skipping")
      rescue
        UI.message("Publishing GitHub release #{tag}")
        sh("gh", "release", "create", tag, apk,
           "--title", "Vivid #{tag}",
           "--generate-notes")
      end
    else
      base = `git describe --tags --abbrev=0 2>/dev/null`.strip.sub(/^v/, "")
      base = "1.0" if base.empty?
      run_raw = ENV["GITHUB_RUN_NUMBER"] || "0"
      version_name = options[:version_name] || "#{base}-nightly.#{run_raw}"
      tag = "nightly"

      begin
        sh("gh", "release", "delete", tag, "--yes", "--cleanup-tag")
        sh("git", "push", "origin", ":refs/tags/#{tag}") rescue nil
        sh("git", "tag", "-d", tag) rescue nil
        UI.important("Removed previous nightly release")
      rescue
        UI.important("No previous nightly release to remove")
      end
      UI.message("Publishing nightly prerelease #{version_name}")
      sh("gh", "release", "create", tag, apk,
         "--title", "Vivid nightly (#{version_name})",
         "--notes", "Nightly feature build — installable via Obtainium (enable pre-releases).",
         "--target", "develop",
         "--prerelease",
         "--latest=false")
    end
  end
end