    <!-- ===== Darstellung (SettingsAppearanceScreen.kt) ===== -->
    <string name="appearance_mode_title">Design-Modus</string>
    <string name="appearance_mode_desc">Legt fest, ob Vivid hell, dunkel oder im AMOLED-Modus erscheint — oder dem System folgt. AMOLED nutzt rein-schwarze Flächen (spart auf OLED-Displays Energie).</string>
    <string name="appearance_mode_system_desc">Folgt der System-Einstellung deines Geräts (Standard).</string>
    <string name="appearance_mode_light_desc">Immer hell — unabhängig von der System-Einstellung.</string>
    <string name="appearance_mode_dark_desc">Immer dunkel — unabhängig von der System-Einstellung.</string>
    <string name="appearance_mode_amoled_desc">Dunkel mit rein-schwarzen Flächen: maximaler Kontrast, weniger Akku-Verbrauch auf OLED-Screens.</string>
    <string name="appearance_accent_title">Akzentfarbe</string>
    <string name="appearance_accent_desc">Färbt Buttons, Schalter, Links und Hervorhebungen. Jede Farbe ist eine komplette Material-3-Palette (TonalSpot) — der Standard bleibt Vivid-Grün.</string>

