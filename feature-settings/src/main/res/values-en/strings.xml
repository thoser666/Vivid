    <!-- ===== Appearance (SettingsAppearanceScreen.kt) ===== -->
    <string name="appearance_mode_title">Theme mode</string>
    <string name="appearance_mode_desc">Choose whether Vivid appears light, dark or in AMOLED mode — or follows the system. AMOLED uses pure-black surfaces (saves battery on OLED displays).</string>
    <string name="appearance_mode_system_desc">Follows your device\'s system setting (default).</string>
    <string name="appearance_mode_light_desc">Always light — independent of the system setting.</string>
    <string name="appearance_mode_dark_desc">Always dark — independent of the system setting.</string>
    <string name="appearance_mode_amoled_desc">Dark with pure-black surfaces: maximum contrast, less battery drain on OLED screens.</string>
    <string name="appearance_accent_title">Accent color</string>
    <string name="appearance_accent_desc">Colors buttons, switches, links and highlights. Each color is a complete Material-3 palette (TonalSpot) — Vivid Green stays the default.</string>

