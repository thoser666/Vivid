    <string name="stream_tls_label">Sichere Verbindung (RTMPS)</string>
    <string name="multi_streaming_title">Multi-Streaming (optional)</string>
    <string name="multi_streaming_desc">Zweites Stream-Ziel: Das Signal wird gleichzeitig zu beiden Zielen gesendet. Leer lassen, um nur das primäre Ziel zu nutzen.</string>
    <string name="secondary_url_label">Zweite Stream-URL</string>
    <string name="secondary_key_label">Zweiter Stream-Schlüssel</string>
