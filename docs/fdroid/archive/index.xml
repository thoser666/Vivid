<?xml version="1.0" encoding="utf-8"?><fdroid><repo icon="icon.png" name="Vivid Archive" pubkey="" timestamp="1788431739" url="https://thoser666.github.io/Vivid/fdroid/archive" version="20002"><description>Older versions of Vivid, kept available for downgrades and fallback.</description></repo><application id="com.vivid"><id>com.vivid</id><added>2026-09-03</added><lastupdated>2026-09-03</lastupdated><name>Vivid</name><summary>Open source IRL streaming app with chat bot and AI features</summary><desc>&lt;p&gt;Vivid is an open-source IRL streaming application for Android.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Features:&lt;/b&gt;&lt;/p&gt;
&lt;ul&gt;
  &lt;li&gt;Live streaming via RTMP/SRT to Twitch, YouTube, Kick, and custom platforms&lt;/li&gt;
  &lt;li&gt;Real-time chat overlay with badges and emotes&lt;/li&gt;
  &lt;li&gt;AI-powered chat bot with configurable responses&lt;/li&gt;
  &lt;li&gt;Owner remote control commands&lt;/li&gt;
  &lt;li&gt;Dark mode with AMOLED support&lt;/li&gt;
  &lt;li&gt;Multi-language support (English, German, French)&lt;/li&gt;
  &lt;li&gt;Scene management and auto-switching&lt;/li&gt;
  &lt;li&gt;Real-time GPS overlay (altitude, speed, coordinates)&lt;/li&gt;
  &lt;li&gt;Custom RTMP/SRT endpoints&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;a href=&quot;https://github.com/thoser666/Vivid&quot;&gt;Source Code&lt;/a&gt; | &lt;a href=&quot;https://github.com/thoser666/Vivid/issues&quot;&gt;Bug Reports&lt;/a&gt;&lt;/p&gt;</desc><license>MIT</license><categories>Internet,Entertainment,Multimedia</categories><category>Internet</category><web>https://thoser666.github.io/Vivid/</web><source>https://github.com/thoser666/Vivid</source><tracker>https://github.com/thoser666/Vivid/issues</tracker><changelog>https://github.com/thoser666/Vivid/releases</changelog><donate>https://github.com/sponsors/thoser666</donate><marketversion></marketversion><marketvercode>5062</marketvercode><package><version>0.5.6-beta</version><versioncode>5062</versioncode><apkname>v0.5.6-beta_app-release.apk</apkname><hash type="sha256">2d558c85d2f2548adc8bc51de9efcd31db9ab233d667df3fc05f5a003391a54a</hash><size>7712149</size><sdkver>24</sdkver><targetSdkVersion>37</targetSdkVersion><added>2026-09-03</added><sig>62dc323ae2f2256187d32b2dfabf3e6c</sig><permissions>ACCESS_COARSE_LOCATION,ACCESS_FINE_LOCATION,ACCESS_LOCAL_NETWORK,ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_CAMERA,FOREGROUND_SERVICE_MICROPHONE,INTERNET,POST_NOTIFICATIONS,RECORD_AUDIO,WAKE_LOCK,com.vivid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION</permissions><nativecode>arm64-v8a,armeabi-v7a,x86,x86_64</nativecode><features>android.hardware.camera.any</features></package><package><version>0.5.5-beta</version><versioncode>5052</versioncode><apkname>v0.5.5-beta_app-release.apk</apkname><hash type="sha256">747f502305d24b3953237a133c68b5ad38b634e8fea60b909d7d01a0e0f942de</hash><size>7936756</size><sdkver>24</sdkver><targetSdkVersion>37</targetSdkVersion><added>2026-09-03</added><sig>62dc323ae2f2256187d32b2dfabf3e6c</sig><permissions>ACCESS_COARSE_LOCATION,ACCESS_FINE_LOCATION,ACCESS_LOCAL_NETWORK,ACCESS_NETWORK_STATE,CAMERA,FOREGROUND_SERVICE,FOREGROUND_SERVICE_CAMERA,FOREGROUND_SERVICE_MICROPHONE,INTERNET,POST_NOTIFICATIONS,RECORD_AUDIO,WAKE_LOCK,co