    <!-- ===== Overlays & Widgets (SettingsOverlaysScreen.kt) ===== -->
    <string name="overlays_chat_title">Chat-Overlay</string>
    <string name="overlays_chat_desc">Zeigt den Twitch-Chat des angegebenen Kanals über der Streaming-Vorschau an (anonym gelesen).</string>
    <string name="overlays_channel_label">Twitch-Kanal (ohne #)</string>
    <string name="overlays_chat_enabled">Chat-Overlay anzeigen</string>
    <string name="overlays_widget_title">Text-/Info-Widget</string>
    <string name="overlays_widget_desc">Zeigt Uhrzeit, GPS-Koordinaten und Geschwindigkeit als Overlay rechts unten über der Streaming-Vorschau an. Für GPS/Geschwindigkeit wird die Standort-Berechtigung benötigt.</string>
    <string name="overlays_widget_enabled">Widget anzeigen</string>
    <string name="overlays_widget_time">Uhrzeit</string>
    <string name="overlays_widget_location">GPS-Koordinaten</string>
    <string name="overlays_widget_speed">Geschwindigkeit</string>
    <string name="overlays_widget_altitude">Höhe</string>
    <string name="overlays_emotes_title">Third-Party-Emotes</string>
    <string name="overlays_emotes_desc">Zusätzliche Emotes aus Community-Datenbanken im Chat-Overlay anzeigen. Jede Quelle kann einzeln aktiviert/deaktiviert werden.</string>
    <string name="overlays_emotes_bttv">BetterTTV (BTTV)</string>
    <string name="overlays_emotes_ffz">FrankerFaceZ (FFZ)</string>
    <string name="overlays_emotes_7tv">7TV</string>
    <string name="overlays_deleted_title">Gelöschte Nachrichten</string>
    <string name="overlays_deleted_desc">Gelöschte Nachrichten im Chat-Overlay ausblenden oder ausgrauen. Erfordert Moderator-Rechte des Bot-Kontos.</string>
    <string name="overlays_deleted_hide">Gelöschte Nachrichten ausblenden</string>

    <!-- ===== Remote & Datenschutz (SettingsRemotePrivacyScreen.kt) ===== -->
    <string name="remote_section_title">Web-Remote-Control</string>
    <string name="remote_reachable_desc">Im gleichen WLAN erreichbar unter http://&lt;GERÄTE-IP&gt;:%1$d/status — Aktionen via Authorization: Bearer &lt;token&gt;.</string>
    <string name="remote_token_label">Remote-Token</string>
    <string name="remote_token_loading">Token wird geladen…</string>
    <string name="remote_permission_button">LAN-Zugriff für Remote-Control erlauben</string>
    <string name="privacy_section_title">Datenschutz &amp; Fehlerberichte</string>
    <string name="privacy_sentry_toggle">Fehlerberichte senden (Sentry)</string>
    <string name="privacy_sentry_desc">Sendet bei Abstürzen Fehlerberichte an Sentry (Standard: an). Es werden keine Screenshots aufgenommen; Geräte-/IP-Informationen sind deaktiviert. Aus = es wird nichts an Sentry übertragen. Details: PRIVACY.md im Repository.</string>

