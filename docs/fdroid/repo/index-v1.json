{"repo": {"timestamp": 1790309460000, "version": 20002, "name": "Vivid", "icon": "icon.png", "address": "https://thoser666.github.io/Vivid/fdroid/repo", "description": "Vivid - Open Source IRL Streaming App with Chat Bot & AI Features"}, "requests": {"install": [], "uninstall": []}, "apps": [{"categories": ["Internet", "Entertainment", "Multimedia"], "changelog": "https://github.com/thoser666/Vivid/releases", "suggestedVersionCode": "5192", "description": "<p>Vivid is an open-source IRL streaming application for Android.</p>\n<p><b>Features:</b></p>\n<ul>\n  <li>Live streaming via RTMP/SRT to Twitch, YouTube, Kick, and custom platforms</li>\n  <li>Real-time chat overlay with badges and emotes</li>\n  <li>AI-powered chat bot with configurable responses</li>\n  <li>Owner remote control commands</li>\n  <li>Dark mode with AMOLED support</li>\n  <li>Multi-language support (English, German, French)</li>\n  <li>Scene management and auto-switching</li>\n  <li>Real-time GPS overlay (altitude, speed, coordinates)</li>\n  <li>Custom RTMP/SRT endpoints</li>\n</ul>\n<p><a href=\"https://github.com/thoser666/Vivid\">Source Code</a> | <a href=\"https://github.com/thoser666/Vivid/issues\">Bug Reports</a></p>", "donate": "https://github.com/sponsors/thoser666", "issueTracker": "https://github.com/thoser666/Vivid/issues", "license": "MIT", "sourceCode": "https://github.com/thoser666/Vivid", "summary": "Open source IRL streaming app with chat bot and AI features", "webSite": "https://thoser666.github.io/Vivid/", "added": 1790309452000, "packageName": "com.vivid", "lastUpdated": 1790309456000, "localized": {"en-US": {"name": "Vivid"}}}], "packages": {"com.vivid": [{"added": 1790309455000, "apkName": "v0.5.19-beta_app-standard-release.apk", "features": ["android.hardware.camera.any"], "hash": "75beac6c66693f60381d42939adf86b6995d2b3971ac3fdafde7d3185e5f3bda", "hashType": "sha256", "minSdkVersion": 24, "nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "packageName": "com.vivi